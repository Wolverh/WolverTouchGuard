<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pure_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="WOLVER TOUCH GUARD PRO"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="v4.2.1 • Instant DPI Switcher • Auto Free Fire Trigger • 6 Zones"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 0. IN-APP UPDATE SYSTEM (DIRECT DOWNLOAD & INSTALL) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DIRECT IN-APP UPDATER"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentVersionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v4.2.1"
                    android:textColor="@color/accent_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUpdateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Checking for latest version from GitHub..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/button_dark"
                android:text="🔄 Check &amp; Install Latest Update Directly"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 1. SYSTEM ACCESSIBILITY STATUS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. ACCESSIBILITY OVERLAY SERVICE"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Checking status..."
                android:textColor="@color/accent_red"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="First open App Info -&gt; 3 dots -&gt; Allow restricted settings, and set Battery to Unrestricted."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOpenAppInfo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:text="1. App Info"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnOpenAccessibility"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent_red"
                    android:text="2. Accessibility"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. EXACT DPI SENSITIVITY ENGINE (BASE: 371 DP) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. EXACT DPI SENSITIVITY ENGINE (BASE: 371 DP)"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- STATUS BANNER -->
            <TextView
                android:id="@+id/tvDpiStatusBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/button_dark"
                android:padding="10dp"
                android:text="STATUS: ○ DEACTIVATED (Default 371 DP Active)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 2 PROMINENT BUTTONS: ACTIVATE & DEACTIVATE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnActivateDpiMain"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent_green"
                    android:text="⚡ ACTIVATE DPI"
                    android:textAllCaps="false"
                    android:textColor="@color/bg_pure_black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDeactivateDpiMain"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent_red"
                    android:text="⏸️ DEACTIVATE (371)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Target DPI (Type exact number, e.g. 550, 720, 800, 960, 1200):"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etTargetDpi"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@color/button_dark"
                    android:hint="Target DPI (e.g. 960)"
                    android:inputType="number"
                    android:maxLength="4"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="960"
                    android:textColor="@color/accent_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="DP"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- QUICK PRESET BUTTONS (550, 720, 800, 960, 1200, 1440) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPreset550"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:padding="0dp"
                    android:text="550"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnPreset720"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:padding="0dp"
                    android:text="720"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnPreset800"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:padding="0dp"
                    android:text="800"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnPreset960"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:padding="0dp"
                    android:text="960"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnPreset1200"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:padding="0dp"
                    android:text="1200"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnPreset1440"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:padding="0dp"
                    android:text="1440"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- BASE DPI AND Y BOOST -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Native Base DPI (371):"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etBaseDpi"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/button_dark"
                        android:hint="371"
                        android:inputType="number"
                        android:maxLength="4"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="371"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Y-Drag Boost % (0-150):"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etYAxisBoost"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/button_dark"
                        android:hint="25"
                        android:inputType="number"
                        android:maxLength="3"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="25"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TELEMETRY REPORT -->
            <TextView
                android:id="@+id/tvDpiTelemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/button_dark"
                android:padding="10dp"
                android:text="Status: Loading DPI telemetry..."
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:typeface="monospace" />

            <!-- ADB PERMISSION HELP BUTTON -->
            <Button
                android:id="@+id/btnAdbHelp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/button_dark"
                android:text="🔑 ADB Permission Guide (If Unrooted)"
                android:textAllCaps="false"
                android:textColor="@color/accent_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. MASTER ENGINE & AUTO-FREE FIRE LAUNCH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. AUTO-START IN FREE FIRE &amp; TARGET GAMES"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchMasterEnable"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Enable Touch Guard Master Engine"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoLockOnGame"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="⚡ Auto-Activate Immediately When Free Fire Opens"
                android:textColor="@color/accent_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoLandscape"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🔄 Auto-Run Whenever Phone Enters Landscape"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAppFilter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Restrict to Selected Games / Landscape Only"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSelectedAppsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Selected: com.dts.freefireth, com.dts.freefiremax"
                android:textColor="@color/accent_green"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSelectApps"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/button_dark"
                android:text="Choose Target Games / Apps"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- 4. FLOATING TOGGLE & IN-GAME CONTROL CENTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. FLOATING TOGGLE &amp; STEALTH CONTROL"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchShowFloatingToggle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="🔘 Show Floating Toggle Bar on Screen"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Turn OFF (or tap Hide inside the toggle menu) to hide the toggle bar completely while keeping touch blockage 100% ACTIVE! Press Vol Up + Vol Down anytime to bring the toggle back."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnOpenInGameMenuNow"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/accent_blue"
                android:text="⚙️ Open In-Game Quick Control Menu Now"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchViewBarsOnScreen"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="👁️ Preview Red Blockage Bars Inside App"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/card_border" />

            <!-- FIXED RADAR SCREEN FRAME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RADAR MONITOR (TAP ANY ZONE OR BUTTON BELOW):"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.wolver.touchguard.ScreenRadarView
                android:id="@+id/radarScreenPreview"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <!-- 6 ZONE SELECTOR BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSelectZ1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent_red"
                    android:padding="0dp"
                    android:text="Z1"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSelectZ2"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:padding="0dp"
                    android:text="Z2"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSelectZ3"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:padding="0dp"
                    android:text="Z3"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSelectZ4"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:padding="0dp"
                    android:text="Z4"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSelectZ5"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:padding="0dp"
                    android:text="Z5"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSelectZ6"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_dark"
                    android:padding="0dp"
                    android:text="Z6"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEditingZoneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Adjusting: Zone 1"
                android:textColor="@color/accent_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- SLIDERS -->
            <TextView
                android:id="@+id/tvZoneX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Horizontal Position (X): 0 px"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekZoneX"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:max="2600" />

            <TextView
                android:id="@+id/tvZoneY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vertical Position (Y): 0 px"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekZoneY"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:max="1200" />

            <TextView
                android:id="@+id/tvZoneW"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Zone Width: 220 px"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekZoneW"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:max="2644" />

            <TextView
                android:id="@+id/tvZoneH"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Zone Height: 600 px"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekZoneH"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:max="1208" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnForceEditMode"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent_red"
                    android:text="✏️ Edit Mode (Show Bars)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnForceLockMode"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent_green"
                    android:text="🔒 Lock In (Activate Guard)"
                    android:textAllCaps="false"
                    android:textColor="@color/bg_pure_black"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. ACTIVE SHIELDS (INCLUDE / EXCLUDE BLOCKS) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. INCLUDE OR EXCLUDE INDIVIDUAL BLOCKS (Z1 - Z6)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchZone1"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:text="Zone 1: Left Edge &amp; Palm Guard"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchZone2"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Zone 2: Top Status Bar &amp; Call Guard"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchZone3"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Zone 3: Below 3rd-Finger Claw Button"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchZone4"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Zone 4: Right of 3rd-Finger Button"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchZone5"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Zone 5: Above Joystick Shield"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchZone6"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Zone 6: Right Edge / Fire Shield"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/card_border" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchHidePillInLock"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Auto-Hide Toggle Bar When Locked (Blockage Stays ON)"
                android:textColor="@color/accent_green"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchLockBorder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Show Faint Green Border in Lock Mode (To Verify Blocking)"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tvOpacityValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Edit Mode Red Opacity: 50%"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekBarEditOpacity"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:max="95"
                android:progress="50" />
        </LinearLayout>

        <!-- 6. RESET -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. RESET CONTROLS"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnResetZones"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/button_dark"
                android:text="Reset All Zones &amp; Restore Defaults"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
